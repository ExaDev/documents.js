{
  // A no-op Worker whose only purpose is to host xls-codec's source as the module graph the workers test suite (test/workers/**) imports against under the real workerd runtime -- there is no fetch handler to exercise, only the library's own compound-file selection, BIFF8 record parsing, and schema mapping running inside a Cloudflare Workers isolate to prove it carries zero Node-only API usage.
  "name": "xls-codec-workers-test",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
}
