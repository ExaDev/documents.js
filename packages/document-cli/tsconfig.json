{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true,
    // eslint.config.ts imports the workspace-root eslint.shared.ts by its real path, extension included, which is what ESLint's own TS config loader resolves. TypeScript rejects a .ts import specifier without this, and permits it here because noEmit is set.
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tsdown.config.ts",
    "vitest.config.ts",
    "vitest.workers.config.ts",
    "commitlint.config.ts",
    "release.config.ts",
    "eslint.config.ts",
    "lint-staged.config.ts"
  ]
}
