{
  // A no-op Worker whose only purpose is to host ooxml.js's source as the module graph the workers test suite (test/workers/**) imports against under the real workerd runtime -- there is no fetch handler to exercise, only the library's own OOXML decode/zip primitives running inside a Cloudflare Workers isolate to prove they carry zero Node-only API usage.
  "name": "ooxml-js-workers-test",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23"
}
