{
  // A no-op Worker whose only purpose is to host rtf-codec's source as the module graph the workers test suite (test/workers/**) imports against under the real workerd runtime -- there is no fetch handler to exercise, only the library's own readRtf/writeRtf running inside a Cloudflare Workers isolate to prove the codec carries zero Node-only API usage.
  "name": "rtf-codec-workers-test",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
}
