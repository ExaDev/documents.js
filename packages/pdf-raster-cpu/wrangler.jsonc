{
  // A no-op Worker whose only purpose is to host pdf-raster-cpu's source as the module graph the workers test suite (test/workers/**) imports against under the real workerd runtime -- there is no fetch handler to exercise, only the rasteriser itself (and, through the pdf-codec/raster entry, the page walk driving it) running inside a Cloudflare Workers isolate to prove the production source carries zero Node-only API usage.
  "name": "pdf-raster-cpu-workers-test",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
}
