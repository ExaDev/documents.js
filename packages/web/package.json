{
  "name": "web",
  "private": true,
  "version": "2.18.105",
  "type": "module",
  "description": "A client-only, statically-built web UI for every conversion and editing tool in the documents.js ecosystem.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/documents.js.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/ExaDev/documents.js/tree/main/packages/web",
  "bugs": {
    "url": "https://github.com/ExaDev/documents.js/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "turbo run _build",
    "_build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "typecheck": "turbo run _typecheck",
    "_typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "turbo run _lint",
    "_lint": "eslint . --cache --max-warnings 0",
    "test": "turbo run _test",
    "_test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "turbo run _test:coverage",
    "_test:coverage": "vitest run --project unit --coverage",
    "test:mutation": "turbo run _test:mutation",
    "_test:mutation": "stryker run stryker.config.ts",
    "test:e2e": "turbo run _test:e2e",
    "_test:e2e": "playwright test",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "dependencies": {
    "@mantine/core": "9.7.5",
    "@mantine/dropzone": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@mantine/notifications": "9.7.5",
    "@mantine/vanilla-extract": "9.7.5",
    "@orpc/client": "1.16.1",
    "@orpc/server": "1.16.1",
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/dynamic": "2.1.5",
    "@vanilla-extract/recipes": "0.5.7",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "document-schema.js": "7.16.3",
    "documents.js": "14.11.3",
    "markdown-codec": "11.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tanstack/router-plugin": "1.168.48",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/wicg-file-system-access": "2023.10.7",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "ooxml.js": "12.2.37",
    "semantic-release": "25.0.9",
    "typescript": "6.0.3",
