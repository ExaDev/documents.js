{
  "name": "markdown-codec",
  "version": "1.1.17",
  "description": "Hand-written CommonMark+GFM <-> ContentDocument codec, built on document-schema.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/markdown-codec.git"
  },
  "homepage": "https://github.com/ExaDev/markdown-codec#readme",
  "bugs": {
    "url": "https://github.com/ExaDev/markdown-codec/issues"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": {
        "import": "./dist/*.d.ts",
        "require": "./dist/*.d.cts"
      },
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && tsdown && publint && attw --pack",
    "lint": "eslint . --fix --cache --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:corpus": "vitest run --project corpus",
    "test:smoke": "tsdown && vitest run --project smoke",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "keywords": [
    "markdown",
    "commonmark",
    "gfm",
    "codec",
    "round-trip",
    "zod",
    "ast"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "dependencies": {
    "document-schema.js": "^2.4.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "publint": "^0.3.21",
    "semantic-release": "^25.0.8",
    "tsdown": "^0.22.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
