{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "types": ["vite/client", "wicg-file-system-access"]
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/workers/**",
    "src/**/*.worker.ts",
    "src/rpc/router.ts",
    "src/rpc/sessionRouter.ts"
  ]
}
