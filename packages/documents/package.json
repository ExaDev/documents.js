{
  "name": "documents",
  "private": true,
  "version": "2.3.2",
  "type": "module",
  "description": "A client-only, statically-built web UI for every conversion and editing tool in the documents.js ecosystem.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExaDev/documents.js.git",
    "directory": "packages/documents"
  },
  "homepage": "https://github.com/ExaDev/documents.js/tree/main/packages/documents",
  "bugs": {
    "url": "https://github.com/ExaDev/documents.js/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "turbo run _build",
    "_build": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "typecheck": "turbo run _typecheck",
    "_typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "lint": "turbo run _lint",
    "_lint": "eslint . --cache --max-warnings 0",
    "test": "turbo run _test",
    "_test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "turbo run _test:coverage",
    "_test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/dropzone": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@mantine/vanilla-extract": "^9.5.1",
    "@orpc/client": "^1.14.15",
    "@orpc/server": "^1.14.15",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.23",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/dynamic": "^2.1.5",
    "@vanilla-extract/recipes": "^0.5.7",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "document-schema.js": "^5.5.1",
    "documents.js": "^6.5.0",
    "markdown-codec": "^6.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tanstack/router-plugin": "^1.168.27",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
