{
  // A no-op Worker whose only purpose is to host documents.js's source as the module graph the workers test suite (test/workers/**) imports against under the real workerd runtime -- there is no fetch handler to exercise, only the library's own PDF-bypassing content/bridge functions (markdownToDocx, readDocxContent, decodePackage) running inside a Cloudflare Workers isolate to prove they carry no Node-only API usage on the paths the test exercises. The barrel src/index.ts is the package's own main entry point, so it is the natural module graph root; importing through it is also what every external consumer does.
  "name": "documents-js-workers-test",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23"
}
